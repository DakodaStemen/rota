# Pinned inputs for the Rotate OS image build. Changing a pin invalidates the stage stamp.
SPL_REPO=https://github.com/crackerjacques/ums512_spl.git
SPL_REF=armbian
SPL_SHA=3c5f3547ff42f676e64b70f899ca74c667c7cbbf
SPL_VARIANT=open

UBOOT_REPO=https://github.com/crackerjacques/u-boot-ums512.git
UBOOT_SHA=d1f91089bcb2df300f1e8a92938c1ca84a183e8c
UBOOT_DEFCONFIG=ums512_rg_rotate_defconfig
UBOOT_DT=ums512_rg_rotate

KERNEL_SHA=fedeb60b65055aacc35f4231692f808748c5de31
KERNEL_BASE_DEFCONFIG=ums512_defconfig
KERNEL_DTB=sprd/ums512-rg-rotate.dtb

ALARM_TARBALL=upstream/alarm/ArchLinuxARM-aarch64-latest.tar.gz
ALARM_MD5=23eec86365b24f7913c403e8f4e8719b

# SD layout (research 01 section 5)
UBOOT_PART_START_MIB=1
UBOOT_PART_MIB=16
BOOT_PART_MIB=256
IMAGE_SIZE_MIB=6144
UBOOT_MAX_PAYLOAD=1048576
