# Pinned inputs for the Rotate OS image build. Changing a pin invalidates the stage stamp.
# thwonp/ums512_spl plorpos-cm4 = crackerjacques armbian 3c5f354 + one commit (e229396: skip cm4_sec(), CONFIG_SPL_CM4_NS_RESET)
SPL_REPO=https://github.com/thwonp/ums512_spl.git
SPL_REF=plorpos-cm4
SPL_SHA=e22939608b6edee0fe7f5b810ea9bb2e7b25cd44
SPL_VARIANT=open

UBOOT_REPO=https://github.com/crackerjacques/u-boot-ums512.git
UBOOT_SHA=d1f91089bcb2df300f1e8a92938c1ca84a183e8c
UBOOT_DEFCONFIG=ums512_rg_rotate_defconfig
UBOOT_DT=ums512_rg_rotate

KERNEL_SHA=fedeb60b65055aacc35f4231692f808748c5de31
KERNEL_BASE_DEFCONFIG=ums512_defconfig
KERNEL_DTB=sprd/ums512-rg-rotate.dtb

ALARM_TARBALL=upstream/alarm/ArchLinuxARM-aarch64-latest.tar.gz
ALARM_MD5=23eec86365b24f7913c403e8f4e8719b

# SD layout (research 01 section 5)
UBOOT_PART_START_MIB=1
UBOOT_PART_MIB=16
BOOT_PART_MIB=256
IMAGE_SIZE_MIB=6144
UBOOT_MAX_PAYLOAD=1048576

# PortMaster (https://github.com/PortsMaster/PortMaster-GUI/releases/tag/2026.10.29-1355, asset PortMaster.zip)
# sha256 = GitHub release asset digest, re-computed locally; md5 matches the release's PortMaster.zip.md5 (c8c72815e93dedbb3fd80bb5ddf91fcf)
PORTMASTER_VERSION=2026.10.29-1355
PORTMASTER_URL=https://github.com/PortsMaster/PortMaster-GUI/releases/download/2026.10.29-1355/PortMaster.zip
PORTMASTER_SHA256=6261911f9ddd1e466f2041c3a20e0d78b6e17ca262a3d542f5f4c28c11ed9643
