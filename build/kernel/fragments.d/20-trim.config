# kernel-trim.config - Rotate OS trim fragment for ums512_defconfig (linux 7.2.9, thwonp rotate-fixes fedeb60b6)
# Usage, from the kernel tree (validated with merge_config.sh, see docs/kernel-trim-proposal.md section 8):
#   ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu- scripts/kconfig/merge_config.sh arch/arm64/configs/ums512_defconfig docs/kernel-trim.config
#   (or: make ums512_defconfig; merge_config.sh .config kernel-trim.config; make olddefconfig)
# Rationale per line: docs/kernel-trim-proposal.md. "# CONFIG_X is not set" lines are requests to disable.

# --- 1. Add: needed but missing or not sticking
CONFIG_ANDROID_BINDERFS=y
CONFIG_INPUT_UINPUT=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_ARM_PMU=y

# --- 2. Game performance: scheduler, preemption, idle, memory
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
# CONFIG_SCHED_SMT is not set
CONFIG_CPU_IDLE_GOV_TEO=y
# CONFIG_CPU_IDLE_GOV_MENU is not set
# CONFIG_TRANSPARENT_HUGEPAGE is not set
# CONFIG_KSM is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_MEMORY_HOTREMOVE is not set
# CONFIG_MEMORY_FAILURE is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_ZSTD is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# --- 3. cpufreq governors
# CONFIG_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_GOV_USERSPACE is not set
# CONFIG_ARM_SCPI_CPUFREQ is not set
# CONFIG_ARM_SCMI_CPUFREQ is not set

