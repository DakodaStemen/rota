# Rotate OS kernel fragment, merged over arch/arm64/configs/ums512_defconfig.
# Source of truth for what we change from thwonp/linux-mainline-sprd rotate-fixes.
# Reason: defconfig has ANDROID_BINDER_IPC=y but no ANDROID_BINDERFS (Waydroid wants binderfs;
# docs/research/01-boot-kernel.md section 8).
CONFIG_ANDROID_BINDERFS=y
