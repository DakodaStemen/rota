# kernel-virt stage only: what the QEMU "virt" machine needs on top of the Rotate OS kernel config.
# Everything is built in (=y) so root=/dev/vda3 mounts with no initramfs. Not used by the device kernel.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
